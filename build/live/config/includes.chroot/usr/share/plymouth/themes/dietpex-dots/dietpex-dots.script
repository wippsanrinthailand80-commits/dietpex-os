# dietpex-dots.script - DietPEX logo dot-assembly boot splash (generated).
#
# Phase 1 (0-4.5s): a teal snake and a blue snake weave serpently across
#   the logo mark, placing glowing dots one by one until the mark is
#   assembled. Phase 2 (4.5-6s): the white wordmark + tagline fill in.
#   Phase 3 (6-7.5s): hold. Phase 4 (7.5-9s): the real logo fades in over
#   the assembled dots.

mark_dur = 4.5;
text_dur = 1.5;
hold_dur = 1.5;
fade_dur = 1.5;
dot_fade = 0.12;
count = 543;

