sprites = [];
global.tick = 0;

fun setup () {
  ratio = Window.GetWidth() / 1920.0;
  bg = Sprite(Image("bg.png").Scale(Window.GetWidth(), Window.GetHeight()));
  bg.SetZ(-1000);
  dot0 = Image("dot-teal.png").Scale(34 * ratio, 34 * ratio);
  dot1 = Image("dot-blue.png").Scale(34 * ratio, 34 * ratio);
  dot2 = Image("dot-white.png").Scale(34 * ratio, 34 * ratio);
  dw = 34 * ratio;
  logo_w = 0.308 * Window.GetWidth();
  logo_h = logo_w * 1.122363;
  gx = (Window.GetWidth() - logo_w) / 2;
  gy = (Window.GetHeight() - logo_h) / 2;
  i = 0;
  while (i < count) {
    s = Sprite();
    s.SetZ(100);
    s.SetPosition(gx + state.sx[i] * logo_w - dw / 2, gy + state.sy[i] * logo_h - dw / 2, 100);
    s.SetOpacity(0);
    if (state.c[i] == 0) s.SetImage(dot0);
    if (state.c[i] == 1) s.SetImage(dot1);
    if (state.c[i] == 2) s.SetImage(dot2);
    sprites[i] = s;
    i = i + 1;
  }
  global.logo_img = Image("logo.png").Scale(logo_w, logo_h);
  global.logo_sprite = Sprite(global.logo_img);
  global.logo_sprite.SetZ(200);
  global.logo_sprite.SetPosition(gx, gy, 200);
  global.logo_sprite.SetOpacity(0);
}

fun refresh_callback () {
  global.tick = global.tick + 1;
  t = global.tick / 50.0;
  i = 0;
  while (i < count) {
    if (state.ph[i] == 0) rev_t = state.rf[i] * mark_dur;
    else rev_t = mark_dur + state.rf[i] * text_dur;
    local_fade = (t - rev_t) / dot_fade;
    op = 1.0;
    if (local_fade < 0.0) op = 0.0;
    if (local_fade >= 0.0 && local_fade < 1.0) op = local_fade;
    if (t > mark_dur + text_dur + hold_dur) {
      fade = (t - (mark_dur + text_dur + hold_dur)) / fade_dur;
      if (fade > 1.0) fade = 1.0;
      op = op * (1.0 - fade);
    }
    sprites[i].SetOpacity(op);
    i = i + 1;
  }
  logo_op = 0.0;
  if (t > mark_dur + text_dur + hold_dur) {
    fade = (t - (mark_dur + text_dur + hold_dur)) / fade_dur;
    if (fade > 1.0) fade = 1.0;
    logo_op = fade;
  }
  global.logo_sprite.SetOpacity(logo_op);
}

fun quit_callback () {}

setup();
Plymouth.SetRefreshRate(50);
Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetQuitFunction(quit_callback);
