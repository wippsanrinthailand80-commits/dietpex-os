# dietpex OS - live desktop package list.
#
# A real, bootable Ubuntu-based OS with the XFCE desktop, full Thai support
# (fonts + fontconfig vowel fix), and the dietpex trim applied at build time.

# --- Desktop environment ---
xfce4
xfce4-terminal
xfce4-goodies
lightdm
lightdm-gtk-greeter
network-manager

# --- UI theme (dark, modern look instead of the bland stock GTK) ---
arc-theme
papirus-icon-theme
xfce4-whiskermenu-plugin
plank

# --- Apps exercised by the live desktop UI test ---
iputils-ping
wmctrl
thunar
mousepad
xdotool
x11-xkb-utils
xclip

# --- Thai support (fonts + vowel positioning) ---
fonts-noto-core
fonts-thai-tlwg
fonts-thai-tlwg-ttf
fonts-thai-tlwg-web
locales

# --- Base tools the live session needs ---
sudo
bash
coreutils
util-linux
curl
ca-certificates

# --- Build-time tooling that must exist inside the chroot ---
# isohybrid (from syslinux-utils) finalizes the ISO into a hybrid image
# that boots from both USB and CD. It runs via binary.sh inside the chroot.
# librsvg2-bin renders the live-build theme's boot splash.
# isolinux provides /usr/lib/ISOLINUX/isolinux.bin, the target of the
# bootloader theme's symlinks (config/bootloaders/isolinux).
syslinux
syslinux-common
syslinux-utils
isolinux
librsvg2-bin
