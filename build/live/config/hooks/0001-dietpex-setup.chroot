#!/bin/bash
# dietpex OS - build-time chroot hook.
# Runs inside the live-build chroot to set up the real OS:
#   - create the dietpex user (autologin)
#   - apply the service trim (mask units)
#   - generate the th_TH locale
#   - install the Thai fontconfig rule
#   - point LightDM at XFCE

set -euo pipefail

echo "== dietpex live hook: creating user =="
# The live session autologs into the 'dietpex' user (see lightdm config).
if ! id -u dietpex >/dev/null 2>&1; then
  useradd -m -s /bin/bash -G sudo,cdrom,dip,video,plugdev dietpex
fi
echo "dietpex:dietpex" | chpasswd

echo "== dietpex live hook: plank dock config =="
# A modern translucent dock with the key app launchers; config is written
# here (not via includes.chroot) so the files are owned by the dietpex user.
PLANK_HOME=/home/dietpex/.config/plank/dock1
mkdir -p "$PLANK_HOME/launchers"
cat > "$PLANK_HOME/settings" <<'EOF'
[PlankDockPreferences]
Alignment=Center
AutoHide=false
DockItems=firefox.dockitem;thunar.dockitem;mousepad.dockitem;terminal.dockitem;
HideMode=None
IconSize=40
LockIcons=false
Monitor=
Position=Bottom
ShowDockItemNames=false
Theme=Transparent
ZoomEnabled=true
EOF
mkitem() {
  local name="$1" desktop="$2"
  cat > "$PLANK_HOME/launchers/$name.dockitem" <<EOF
[PlankDockItemPreferences]
Launcher=file://$desktop
EOF
}
mkitem firefox   /usr/share/applications/firefox.desktop
mkitem thunar    /usr/share/applications/thunar.desktop
mkitem mousepad  /usr/share/applications/org.xfce.mousepad.desktop
mkitem terminal  /usr/share/applications/org.xfce.Terminal.desktop
chown -R dietpex:dietpex /home/dietpex

echo "== dietpex live hook: hostname =="
echo "dietpex-os" > /etc/hostname
sed -i 's/^127.0.1.1.*/127.0.1.1\tdietpex-os/' /etc/hosts 2>/dev/null || true

echo "== dietpex live hook: service trim (mask units) =="
# Create mask symlinks directly (no systemd DBus needed in a chroot).
# Mirrors config/services-disable.list so the live OS is already trimmed.
LIST=/etc/dietpex/services-disable.list
if [[ -f "$LIST" ]]; then
  while IFS= read -r unit; do
    unit="${unit%%#*}"                 # strip comments
    unit="${unit//[[:space:]]/}"
    [[ -z "$unit" ]] && continue
    ln -sf /dev/null "/etc/systemd/system/$unit"
    echo "  masked: $unit"
  done < "$LIST"
fi

echo "== dietpex live hook: default target =="
ln -sf /etc/systemd/system/multi-user.target.wants/graphical.target \
  /etc/systemd/system/default.target 2>/dev/null || true
rm -f /etc/systemd/system/default.target
mkdir -p /etc/systemd/system
ln -sf /usr/lib/systemd/system/graphical.target /etc/systemd/system/default.target

echo "== dietpex live hook: locale =="
sed -i 's/^# *en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen 2>/dev/null || true
sed -i 's/^# *th_TH.UTF-8/th_TH.UTF-8/' /etc/locale.gen 2>/dev/null || true
locale-gen >/dev/null 2>&1 || true
update-locale LANG=en_US.UTF-8 >/dev/null 2>&1 || true

echo "== dietpex live hook: fontconfig cache =="
fc-cache -f >/dev/null 2>&1 || true

echo "== dietpex live hook: rsvg compat for live-build =="
# live-build calls the legacy 'rsvg' CLI (e.g. 'rsvg --format png --height
# 480 --width 640 in.svg out.png'), but noble's librsvg2-bin only ships
# rsvg-convert, which takes a different argument syntax. Provide a small
# wrapper that translates the old invocation.
cat > /usr/bin/rsvg <<'EOF'
#!/bin/bash
WIDTH=""
HEIGHT=""
FMT="png"
INPUT=""
OUTPUT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --width) WIDTH="$2"; shift 2 ;;
    --height) HEIGHT="$2"; shift 2 ;;
    --format) FMT="$2"; shift 2 ;;
    -*) shift ;;
    *) [[ -z "$INPUT" ]] && INPUT="$1" || OUTPUT="$1"; shift ;;
  esac
done
ARGS=()
[[ -n "$WIDTH" ]] && ARGS+=(-w "$WIDTH")
[[ -n "$HEIGHT" ]] && ARGS+=(-h "$HEIGHT")
[[ -n "$OUTPUT" ]] && ARGS+=(-o "$OUTPUT")
exec /usr/bin/rsvg-convert "${ARGS[@]}" "$INPUT"
EOF
chmod +x /usr/bin/rsvg

echo "== dietpex live hook: done =="
