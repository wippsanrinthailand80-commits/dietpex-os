#!/bin/bash
# dietpex OS - install Mozilla Firefox as a real .deb (not the Ubuntu snap
# transitional package, which cannot run inside a live squashfs without snapd).
#
# Uses Mozilla's official apt repository directly inside the chroot so the
# install does not depend on any live-build archive-handling specifics.

set -euo pipefail

echo "== dietpex live hook: Mozilla Firefox (real .deb) =="

command -v curl >/dev/null 2>&1 || { apt-get update -qq >/dev/null; apt-get install -y -qq curl >/dev/null; }
command -v gpg >/dev/null 2>&1 || { apt-get update -qq >/dev/null; apt-get install -y -qq gnupg >/dev/null; }

install -d -m 0755 /etc/apt/keyrings
# The Mozilla signing key is ASCII-armored; apt's gpgv --keyring only accepts
# binary keyrings, so dearmor it first or apt reports NO_PUBKEY.
curl -fsSL https://packages.mozilla.org/apt/repo-signing-key.gpg | \
  gpg --batch --yes --dearmor -o /etc/apt/keyrings/mozilla-archive-keyring.gpg
chmod 0644 /etc/apt/keyrings/mozilla-archive-keyring.gpg

printf 'deb [signed-by=/etc/apt/keyrings/mozilla-archive-keyring.gpg] https://packages.mozilla.org/apt mozilla main\n' \
  > /etc/apt/sources.list.d/mozilla.list

# Ubuntu's firefox is a snap-transitional stub versioned 1:1snap1-0ubuntu5
# (epoch 1). Mozilla's real deb has NO epoch (152.x~build1), so a plain
# version comparison always lets Ubuntu's stub win. Pin the Mozilla archive at
# priority 1001 so the real browser is selected regardless of epoch.
printf 'Package: firefox*\nPin: origin packages.mozilla.org\nPin-Priority: 1001\n' \
  > /etc/apt/preferences.d/99mozilla-firefox

apt-get update -qq
apt-get install -y -qq firefox

echo "== firefox installed: $(dpkg-query -W -f='${Version} (${Maintainer})' firefox 2>/dev/null) =="
